{
   "action": {},
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "all_frames": false,
         "js": [
            "mw_inject.js"
         ],
         "matches": [
            "https://makerworld.com/*"
         ],
         "run_at": "document_end"
      },
      {
         "matches": [
            "https://makerworld.com/*"
         ],
         "js": [
            "mw_injected.js"
         ],
         "css": [
            "mw_injected.css"
         ]
      }
   ],
   "description": "Makerworld Utils",
   "externally_connectable": {
      "matches": [
         "https://makerworld.com/*"
      ]
   },
   "icons": {
      "256": "logo.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Makerworld Utils",
   "permissions": [],
   "short_name": "Makerworld Utils",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.3.0",
   "web_accessible_resources": [
      {
         "matches": [
            "\u003Call_urls>"
         ],
         "resources": [
            "mw_injected.js",
            "index.html",
            "swal.js",
            "img/*"
         ]
      }
   ]
}